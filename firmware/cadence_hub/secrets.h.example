// ⚠ DO NOT PUT REAL VALUES IN THIS FILE. ⚠
//
// This file is TRACKED BY GIT and is published to a PUBLIC repository. Any
// password typed below goes public the next time anything is committed.
//
//   cp secrets.h.example secrets.h      <- then edit secrets.h, not this
//
// secrets.h is gitignored; this file is not. That is the whole difference
// between them, and it is invisible in an editor.
//
// This is the HUB, not the camera board. Each board is flashed separately and
// keeps its own copy, but they must be on the same 2.4 GHz network — the hub
// arms the camera's vision page over the LAN when you press the focus timer.

#pragma once

// The ESP32-S3 has no 5 GHz radio. A 5 GHz SSID will never connect.
//
// These are compile-time constants: changing networks means reflashing. A
// campus captive portal will not work at all — use a phone hotspot with an
// SSID you control, and set it before the demo.
#define WIFI_SSID "your-2.4GHz-ssid"
#define WIFI_PASS "your-wifi-password"

// A second network, tried when the first does not answer. Meant for a phone
// hotspot: an ESP32 joins WPA2-PSK on 2.4 GHz fine, and cannot join the
// WPA2-Enterprise or captive-portal networks most institutions run. Taking the
// instrument somewhere it has never been is otherwise a reflash.
//
// Leave the SSID empty to disable it.
#define WIFI_SSID2 ""
#define WIFI_PASS2 ""


// Backend. A LAN address works for development but is a DHCP lease and will
// move; the deployed dashboard does not.
//
// API_TOKEN must match DEVICE_TOKEN in the dashboard's .env.local and the
// same value in the camera's secrets.h. If they drift, the backend answers
// 401 — and the hub's status page will show "failing (401)".
#define API_BASE  "https://project-cadence-32.vercel.app"
#define API_TOKEN "same-token-as-the-camera-and-dashboard"

// Which device everything is attributed to. Must match the camera's DEVICE_ID
// and the row in the devices table, or the rows land against a device that
// does not exist and the dashboard never shows them.
#define DEVICE_ID "cadence-hub-01"

// ── the camera board, if you have one ────────────────────────────────────
//
// Optional. Leave it commented out and the hub defaults to the mDNS name the
// camera already advertises, which survives a DHCP lease change. Everything
// works without a camera at all — the pill on Home reads STANDALONE and the
// hub behaves exactly as it did before the vision tier existed.
//
// Set it to a bare IP if mDNS does not resolve on your network. Some phone
// hotspots do not forward it, and a hotspot is what docs/WIRING.md recommends
// for the demo. The tell is the pill reading NO CAM while the board is up and
// serving its own /vision page perfectly well in a browser.
//
// #define CAM_HOST "cadence-cam.local"
// #define CAM_HOST "192.168.0.42"
