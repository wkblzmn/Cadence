# Copy to .env.local and fill in. .env.local is gitignored; keep it that way.

# Neon connection string. Use the POOLED one — the hostname contains "-pooler".
# This is the only thing standing in front of the data (schema.sql part 3);
# if it leaks, rotate the role password from the Neon console.
DATABASE_URL=

# Must match DEVICE_ID in firmware/cadence_hub/secrets.h.
DEVICE_ID=cadence-hub-01

# Local days for the daily fold. Storage stays UTC; only bucketing is local.
DISPLAY_TZ=Asia/Dhaka

# Static bearer token for the ingest routes. Must match API_TOKEN in
# firmware/cadence_hub/secrets.h — if they drift, the hub gets 401, treats it
# as unretryable, and discards queued events.
DEVICE_TOKEN=
