# ── credentials — the only truly important lines in this file ────────────
# Glob, not one path: this used to name the hub's file alone, so a second
# board's secrets.h would have been committed to a public repo by default.
firmware/**/secrets.h
secrets.h
dashboard/.env.local
dashboard/.env*.local
.env
.env.local

# ── Next.js / node ───────────────────────────────────────────────────────
node_modules/
.next/
out/
build/
dist/
.vercel/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Arduino ──────────────────────────────────────────────────────────────
firmware/**/build/
*.hex
*.elf
*.bin
*.map

# ── hardware / enclosure ─────────────────────────────────────────────────
# Enclosure design and print files. Kept local.
hardware/

# ── editors / OS ─────────────────────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
# ── the app ──────────────────────────────────────────────────────────────
# The Face Landmarker model is ~3.7 MB of redistributable binary and the
# calibration is per-desk, per-chair. Neither belongs in the repo.
app/face_landmarker.task
app/calibration.json
app/__pycache__/
app/cadence/__pycache__/
app/cadence.log
app/cadence.log.1
# The API token, the unsent sample spool, and which COM port answered last.
# All three are per-machine, and the first is a secret.
app/backend.json
app/spool.json
app/spool.json.tmp
app/serial_port.json

# ── report documents ─────────────────────────────────────────────────────
# Kept outside version control. Word rewrites the whole file on every save, so
# each edit is a fresh ~450 KB binary blob in history that cannot be diffed or
# merged. The lock files it leaves behind are noise too.
*.docx
~$*.docx
