# ── credentials — the only truly important lines in this file ────────────
# Glob, not one path: this used to name the hub's file alone, so a second
# board's secrets.h would have been committed to a public repo by default.
firmware/**/secrets.h
secrets.h
dashboard/.env.local
dashboard/.env*.local
.env
.env.local

# ── Next.js / node ───────────────────────────────────────────────────────
node_modules/
.next/
out/
build/
dist/
.vercel/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Arduino ──────────────────────────────────────────────────────────────
firmware/**/build/
*.hex
*.elf
*.bin
*.map

# ── hardware / enclosure ─────────────────────────────────────────────────
# Enclosure design and print files. Kept local.
hardware/

# ── editors / OS ─────────────────────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store