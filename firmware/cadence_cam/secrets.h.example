// ⚠ DO NOT PUT REAL VALUES IN THIS FILE. ⚠
//
// This file is TRACKED BY GIT and is published to a PUBLIC repository. Any
// password typed below goes public the next time anything is committed.
//
//   cp secrets.h.example secrets.h      <- then edit secrets.h, not this
//
// secrets.h is gitignored; this file is not. That is the whole difference
// between them, and it is invisible in an editor.
//
// This is the CAMERA board, not the hub. It has its own copy because the two
// boards are flashed separately — but they must be on the same 2.4 GHz
// network for the phone to reach both.

#pragma once

// The ESP32-S3 has no 5 GHz radio. A 5 GHz SSID will never connect.
#define WIFI_SSID "your-2.4GHz-ssid"
#define WIFI_PASS "your-wifi-password"

// A second network, tried when the first does not answer. Meant for a phone
// hotspot: an ESP32 joins WPA2-PSK on 2.4 GHz fine, and cannot join the
// WPA2-Enterprise or captive-portal networks most institutions run. Taking the
// instrument somewhere it has never been is otherwise a reflash.
//
// Leave the SSID empty to disable it.
#define WIFI_SSID2 ""
#define WIFI_PASS2 ""


// mDNS name, so the stream URL survives a DHCP lease change.
// Reachable at http://cadence-cam.local/stream
#define CAM_HOSTNAME "cadence-cam"

// Backend, for relaying focus samples. The /vision page posts to this board
// and this board forwards with the token attached, so the token never reaches
// a page that anything on the LAN could read.
//
// API_TOKEN must match DEVICE_TOKEN in the dashboard's .env.local, and the
// same value in the hub's secrets.h. If they drift, the backend answers 401.
#define API_BASE  "https://project-cadence-32.vercel.app"
#define API_TOKEN "same-token-as-the-hub-and-dashboard"

// Which device focus samples are attributed to. Must match the hub's
// DEVICE_ID and the row in the devices table, or the samples land against a
// device that does not exist and the dashboard never shows them.
#define DEVICE_ID "cadence-hub-01"
